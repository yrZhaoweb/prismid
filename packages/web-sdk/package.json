{
  "name": "prismid-js",
  "version": "1.1.0",
  "description": "Zero-dependency orthogonal hardware fingerprinting, WebGL shader challenge, and cross-thread lie detection SDK for Browser and Tauri WebView.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yrZhaoweb/prismid.git",
    "directory": "packages/web-sdk"
  },
  "homepage": "https://github.com/yrZhaoweb/prismid",
  "keywords": [
    "fingerprint",
    "device-fingerprint",
    "anti-fraud",
    "bot-detection",
    "webgl",
    "lie-detection",
    "prismid"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/prismid.bundle.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fingerprint-generator": "^2.1.90",
    "fingerprint-injector": "^2.1.90",
    "playwright-core": "^1.65.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
